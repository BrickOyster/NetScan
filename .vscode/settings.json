{
  "[python]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "charliermarsh.ruff",
  },
  "ruff.lint.enable": true,
  "ruff.configuration": "pyproject.toml",
  "python.analysis.typeCheckingMode": "basic",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": ["-synctex=1", "-interaction=nonstopmode", "-file-line-error", "-pdf", "%DOC%"]
    },
    {
      "name": "latexmk-xelatex",
      "command": "latexmk",
      "args": ["-synctex=1", "-interaction=nonstopmode", "-file-line-error", "-xelatex", "%DOC%"]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (pdflatex)",
      "tools": ["latexmk"]
    },
    {
      "name": "latexmk (xelatex)",
      "tools": ["latexmk-xelatex"]
    }
  ],
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.outDir": "%DIR%",
  "latex-workshop.latex.clean.method": "command",
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux", "*.bbl", "*.blg", "*.idx", "*.ind", "*.lof", "*.snm", "*.vrb", "*.dvi",
    "*.lot", "*.out", "*.toc", "*.acn", "*.acr", "*.alg", "*.nav", "*.synctex.gz",
    "*.glg", "*.glo", "*.gls", "*.fls", "*.log", "*.fdb_latexmk"
  ],
  "latex-workshop.latex.autoClean.run": "onSucceeded"
}